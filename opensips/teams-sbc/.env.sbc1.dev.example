# ============================================================================
#  DEV instance "sbc1"  -- copy to .env.sbc1.dev and edit.
#  Run:  scripts/sbc.sh sbc1 dev up -d --build
#  (.env.sbc1.dev is git-ignored; this .example file is committed.)
# ============================================================================

# ---- compose meta (keep ENV_FILE pointing at this file) ----
ENV_FILE=.env.sbc1.dev
COMPOSE_PROJECT_NAME=teams-sbc-sbc1-dev

# ---- identity ----
SBC_INSTANCE=sbc1
DEPLOY_ENV=dev

# ---- Teams TLS leg (the only TLS listener, port 5560) ----
TEAMS_TLS_LISTEN_IP=10.0.0.10
TEAMS_TLS_ADVERTISED_IP=203.0.113.10
TEAMS_TLS_PORT=5560

# ---- core leg (eu.ucp.voiceland.dev:5560/TCP) ----
CORE_FQDN=eu.ucp.voiceland.dev
CORE_PORT=5560
CORE_TRANSPORT=tcp
CORE_LISTEN_IP=10.0.0.10
CORE_ADVERTISED_IP=10.0.0.10
CORE_SIP_PORT=5060
CORE_GROUP=1
# DNS name resolved every 5 min for the trusted core source IPs
CORE_IPS_FQDN=eu.ucp.voiceland.dev

# ---- database (DB_PORT also sets the host-published MariaDB port) ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=opensips
DB_PASS=opensipsrw
DB_NAME=opensips
DB_ROOT_PASS=change-me-root

# ---- management interface ----
MI_HTTP_IP=127.0.0.1
MI_HTTP_PORT=8888
MI_URL=http://127.0.0.1:8888/mi

# ---- media (rtpengine) ----
MEDIA_IP=203.0.113.10
RTP_PORT_MIN=30000
RTP_PORT_MAX=40000
RTPENGINE_SOCK=udp:127.0.0.1:2223

# ---- first-boot self-signed certificate SANs (until ACME issues real ones) ----
BOOTSTRAP_CN=sbc1.teams.ucp.voiceland.dev
BOOTSTRAP_SANS=DNS:*.teams.ucp.voiceland.dev,DNS:eu.ucp.voiceland.dev,DNS:sbc1.teams.ucp.voiceland.dev

# ---- ACME (lego DNS-01) for the rotation sidecar ----
ACME_EMAIL=tls@voiceland.dev
ACME_DNS_PROVIDER=cloudflare
# CLOUDFLARE_DNS_API_TOKEN=...
ROTATE_INTERVAL=86400
