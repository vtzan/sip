# Copy to ../.env (next to docker-compose.yml) and edit. The .env file is
# git-ignored. Also edit local.m4 with the matching IPs before `up`.

# --- database ---
DB_NAME=opensips
DB_USER=opensips
DB_PASS=opensipsrw
DB_ROOT_PASS=change-me-root

# --- media (rtpengine public/advertised IP, matches M_TEAMS_TLS_ADVERTISED_IP) ---
MEDIA_IP=203.0.113.10
RTP_PORT_MIN=30000
RTP_PORT_MAX=40000

# --- core discovery (auto-refreshed every 5 minutes into the address table) ---
# dev : eu.ucp.voiceland.dev      prod : ips.ucp.voiceland.global (2 IPs)
CORE_IPS_FQDN=eu.ucp.voiceland.dev

# --- first-boot self-signed cert SANs (until ACME issues real ones) ---
BOOTSTRAP_CN=sbc.teams.ucp.voiceland.dev
BOOTSTRAP_SANS=DNS:*.teams.ucp.voiceland.dev,DNS:*.teams.ucp.voiceland.global,DNS:eu.ucp.voiceland.dev,DNS:eu.ucp.voiceland.global,DNS:sbc.teams.ucp.voiceland.dev

# --- ACME (lego DNS-01) for the rotation sidecar ---
ACME_EMAIL=tls@voiceland.dev
ACME_DNS_PROVIDER=cloudflare
# Provider secret(s), e.g. for Cloudflare:
# CLOUDFLARE_DNS_API_TOKEN=...
ROTATE_INTERVAL=86400
