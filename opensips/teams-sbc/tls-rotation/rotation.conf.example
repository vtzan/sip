# Copy to rotation.conf and fill in. rotation.conf is git-ignored (DB password).
# Used by manage-tls.py and the rotation sidecar.

[db]
host     = 127.0.0.1
port     = 3306
user     = opensips
password = opensipsrw
name     = opensips
table    = tls_mgm

[rotation]
# Renew when the leaf certificate has this many days (or fewer) left.
renew_threshold_days = 30
# How to reach OpenSIPS MI to hot-reload. Prefer mi_url (HTTP JSON-RPC) in
# containers; otherwise leave it blank and set opensips_cli.
mi_url       = http://127.0.0.1:8888/mi
opensips_cli = opensips-cli

[acme]
# Hook that issues/renews a cert for a set of SANs (see acme-hook.sh).
hook = /etc/opensips/teams-sbc/tls-rotation/acme-hook.sh

# Map a tls_mgm.domain id -> the SAN list to request for it.
# Rows that instead set tls_mgm.match_sip_domain (per-tenant) are auto-issued
# for that FQDN, so they do not need an entry here.
[map]
teams_srv = *.teams.ucp.voiceland.dev,*.teams.ucp.voiceland.global,eu.ucp.voiceland.dev,eu.ucp.voiceland.global,sbc.teams.ucp.voiceland.dev
teams_cli = sbc.teams.ucp.voiceland.dev
